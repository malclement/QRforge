{
  "name": "qr-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first, brand-aware QR design studio with independent decode verification.",
  "type": "module",
  "license": "MIT",
  "author": "Clément Malige",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malclement/QRforge.git"
  },
  "bugs": "https://github.com/malclement/QRforge/issues",
  "homepage": "https://github.com/malclement/QRforge#readme",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "node scripts/dev-ai.mjs",
    "bridge": "node bridge/main.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.bridge.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "samples": "node scripts/run.mjs scripts/build-samples.ts",
    "smoke:claude": "node scripts/smoke-claude.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.18",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.77.0",
    "opentype.js": "^2.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "zxing-wasm": "^3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
